# Copy to .env and fill in deployment values. Never commit the completed .env.
# First initialization only; restarting never changes an existing admin password.
# Use at least 12 characters. Leave blank only when admin already exists.
RB_ADMIN_PASSWORD=
RB_ADMIN_EMAIL=

# REQUIRED for Compose: absolute path visible to the Docker daemon.
# On upgrade, use the exact existing directory; changing it hides existing users
# and profiles behind a new empty database.
RB_SESSION_HOST_DATA_DIR=
RB_SITE_ADDRESS=:80
RB_PUBLIC_URL=http://localhost
RB_DEFAULT_INSTANCE_QUOTA=5

# Empty generates a persistent random secret in DATA_DIR/cookie-secret.
# If supplied, use at least 32 random bytes and keep the same value on restarts.
RB_COOKIE_SECRET=
RB_DOCKER_NETWORK=deploy_remotebrowser
# Manager discovers its own Docker endpoint for isolated instance networks.
RB_MAX_UPLOAD_SIZE=104857600
RB_SESSION_CPUS=2
RB_SESSION_MEMORY_MB=3072
RB_SESSION_SHM_MB=1024
RB_WEBRTC_ICE_IP=127.0.0.1

# Optional SMTP: leave ALL fields below empty to disable email delivery.
# Once enabled: port defaults to 587; encryption defaults to starttls.
# Supported encryption: starttls, tls (implicit TLS, commonly port 465), plain
# (only for a trusted local testing relay; never send public credentials in clear).
RB_SMTP_HOST=
RB_SMTP_PORT=
RB_SMTP_USERNAME=
RB_SMTP_PASSWORD=
RB_SMTP_FROM=
RB_SMTP_ENCRYPTION=
RB_SMTP_TIMEOUT=10s

# RB_SESSION_IDLE_TIMEOUT is deprecated and ignored.
# RB_MAX_SESSIONS is only a fallback default if RB_DEFAULT_INSTANCE_QUOTA is absent;
# neither variable overrides quotas already stored on user accounts.
